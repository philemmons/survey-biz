# ------------------------------------------------------------
# Canonical Brand Standard Site - Ignore Rules
# ------------------------------------------------------------

# Secrets / credentials
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.crt
*.csr
*.kdbx

# Local configuration overrides
*.local.php
*.local.json

# Logs and runtime output
*.log
logs/
*.out
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache and temp
.cache/
.parcel-cache/
.sass-cache/
.tmp/
tmp/
temp/
*.tmp
*.cache

# Backups and archives
*.bak
*.backup
*.old
*.orig
*.save
*.swp
*.swo

# Dependency folders
vendor/
node_modules/

# Build artifacts / generated assets
dist/
build/
public/build/

# Test / coverage / reports
coverage/
.nyc_output/
reports/
report/
lighthouse-report/
lighthouse-reports/
*.lcov
*.coverage
junit.xml

# Editor / IDE
.vscode/
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Keep production routing and server config under version control
!.htaccess
